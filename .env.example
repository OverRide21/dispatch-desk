# Copy this file to .env and set your Gnani API key to enable the live call.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Yashraj

# Enables automatic order lookups and Sarvam 105B interpretation.
SARVAM_API_KEY=

# Optional hosted reply provider and fallback for automatic routing.
GROQ_API_KEY=

# Optional local reply styling. Start Ollama and pull the model first.
OLLAMA_ENABLED=0
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_HARI_ENABLED=0

# Required administrator account. Choose a unique password of at least 12 characters.
DISPATCH_ADMIN_USERNAME=
DISPATCH_ADMIN_PASSWORD=

# Optional order operator. Only the administrator can import files.
DISPATCH_OPERATOR_USERNAME=
DISPATCH_OPERATOR_PASSWORD=

# Use a persistent writable volume and set the public HTTPS origin behind a proxy.
DISPATCH_DB_PATH=.dispatch/dispatch.sqlite
DISPATCH_WORKSPACE_ID=default
DISPATCH_PUBLIC_ORIGIN=
DISPATCH_LOCAL_ACCESS=0
DISPATCH_STOREFRONT_ENABLED=0

# Required on Vercel. The Turso integration supplies these in production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
